{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiftTrace Simulation Run Report",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "organization",
    "scenario",
    "run",
    "interpretation"
  ],
  "properties": {
    "schema": {
      "const": "rifttrace.simulation-run-report"
    },
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "organization": {
      "type": "object"
    },
    "scenario": {
      "type": "object"
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "run_number",
        "status",
        "request_payload",
        "result_payload",
        "metrics"
      ]
    },
    "interpretation": {
      "type": "object"
    }
  }
}
