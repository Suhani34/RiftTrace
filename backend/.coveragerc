[run]
branch = True
source = .
relative_files = True

[report]
show_missing = True
skip_covered = True
skip_empty = True

exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if __name__ == .__main__.:

omit =
    manage.py
    config/asgi.py
    config/wsgi.py
    */migrations/*
    */tests/*
    */tests.py
